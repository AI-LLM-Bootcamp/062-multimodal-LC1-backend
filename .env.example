# Rename this file to .env and add your own values.
# Never upload your .env file to GitHub.

# PostgreSQL database
DATABASE_HOST=localhost
DATABASE_NAME=your_database_name
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_PORT=5432

# AWS S3 (where the PDF files are stored)
AWS_KEY=your_aws_access_key_id
AWS_SECRET=your_aws_secret_access_key
AWS_S3_BUCKET=your_bucket_name

# Unstructured API (extracts text and tables from the PDFs)
UNSTRUCTURED_API_KEY=your_unstructured_api_key

# OpenAI (summaries, page descriptions and the agent)
OPENAI_API_KEY=your_openai_api_key

# LangSmith (to see every step of the app)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=multimodal-pdf-app
#LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com # only for the EU region
